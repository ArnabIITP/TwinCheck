{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TwinCheck Booking API Corpus v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","name","description","timeout_seconds","repeat","max_output_bytes","fixture_hashes","cases","limitations"],
  "properties":{
    "schema_version":{"const":1},
    "name":{"type":"string","minLength":1},
    "description":{"type":"string","minLength":1},
    "timeout_seconds":{"type":"number","exclusiveMinimum":0,"maximum":15},
    "repeat":{"type":"integer","minimum":1,"maximum":3},
    "max_output_bytes":{"type":"integer","minimum":1024,"maximum":100000},
    "fixture_hashes":{"type":"object","minProperties":8,"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "cases":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","sequence","reset_sequence","contract","reference","candidate","expected_finding"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"sequence":{"type":"string"},"reset_sequence":{"type":"string"},"contract":{"type":"string"},"reference":{"type":"object","additionalProperties":false,"required":["fee_delta","capacity"],"properties":{"fee_delta":{"type":"integer"},"capacity":{"type":"integer","minimum":0,"maximum":10}}},"candidate":{"type":"object","additionalProperties":false,"required":["fee_delta","capacity"],"properties":{"fee_delta":{"type":"integer"},"capacity":{"type":"integer","minimum":0,"maximum":10}}},"expected_finding":{"type":"boolean"}}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
