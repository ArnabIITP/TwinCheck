{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArnabIITP/TwinCheck/blob/main/docs/report-schema-v1.schema.json",
  "title": "TwinCheck JSON report schema v1.2",
  "description": "Evidence report produced by TwinCheck's CLI, including process, HTTP, stateful workflow, and stateful exploration reports. Findings contain exact inputs/workflow definitions and observations; reports should be handled as potentially sensitive artifacts.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "reference_command",
    "candidate_command",
    "strategy",
    "seed",
    "repeat",
    "cases_requested",
    "cases_executed",
    "findings",
    "executions",
    "summary",
    "compatibility_contract",
    "compatibility_contract_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool": {
      "const": "TwinCheck"
    },
    "tool_version": {
      "type": "string"
    },
    "reference_command": {
      "type": "string"
    },
    "candidate_command": {
      "type": "string"
    },
    "strategy": {
      "type": "string"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Deterministic generator seed, or null for workflows that do not use a seed."
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "working_directory": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison_policy": {
      "type": "object",
      "properties": {
        "normalize_eol": {
          "type": "boolean"
        },
        "ignore_trailing_whitespace": {
          "type": "boolean"
        },
        "ignore_stderr": {
          "type": "boolean"
        },
        "ignore_exit_code": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "input_source": {
      "type": "string"
    },
    "cases_requested": {
      "type": "integer",
      "minimum": 1
    },
    "cases_executed": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimization_enabled": {
      "type": "boolean"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_index",
          "input_sha256",
          "differences"
        ],
        "properties": {
          "case_index": {
            "type": "integer",
            "minimum": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "differences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_index",
          "input",
          "input_sha256",
          "differences"
        ],
        "properties": {
          "case_index": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "string"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "differences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "minimized": {
            "type": "boolean"
          },
          "minimization_trials": {
            "type": "integer",
            "minimum": 0
          },
          "minimization_limit_reached": {
            "type": "boolean"
          },
          "reference": {
            "$ref": "#/$defs/observation"
          },
          "candidate": {
            "$ref": "#/$defs/observation"
          },
          "reference_runs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observation"
            }
          },
          "candidate_runs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observation"
            }
          },
          "sequence_definition": {
            "$ref": "stateful-http-sequence-v1.schema.json"
          },
          "original_sequence_definition": {
            "$ref": "stateful-http-sequence-v1.schema.json"
          },
          "sequence_file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence_canonical_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mutation_type": {
            "type": "string"
          },
          "mutation_description": {
            "type": "string"
          },
          "step_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay": {
      "type": "object"
    },
    "compatibility_contract": {
      "$ref": "compatibility-contract-v1.schema.json"
    },
    "compatibility_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibility_pack": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "source_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "input_generation": {
      "type": "object",
      "description": "Present when cases were generated from a local JSON Schema file.",
      "properties": {
        "method": {
          "const": "json-schema"
        },
        "json_schema_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "unique_sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "http_adapter": {
      "type": "object",
      "description": "Present for compare-http reports; URLs are loopback-only and request header values are not recorded.",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string"
        },
        "request_header_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "response_headers_compared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_header_values_recorded": {
          "const": false
        },
        "remote_hosts_allowed": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "state_reset": {
      "type": "object",
      "description": "Present when a reset workflow was run before each repeat, exploration candidate, or minimization trial.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sequence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonical_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "sequence_definition": {
          "oneOf": [
            {
              "$ref": "stateful-http-sequence-v1.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "performed_before_each_repeat": {
          "type": "boolean"
        },
        "performed_before_each_variant_and_minimization_trial": {
          "type": "boolean"
        },
        "reset_responses_recorded": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "exploration": {
      "type": "object",
      "description": "Present for deterministic stateful workflow exploration runs.",
      "properties": {
        "algorithm_version": {
          "type": "integer",
          "const": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "mutation_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case_index",
              "type",
              "description"
            ],
            "properties": {
              "case_index": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "minimization_enabled": {
          "type": "boolean"
        },
        "max_findings_to_minimize": {
          "type": "integer",
          "minimum": 0
        },
        "max_minimization_trials": {
          "type": "integer",
          "minimum": 0
        },
        "minimization_trials_total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "returncode",
        "stdout",
        "stderr",
        "timed_out",
        "duration_seconds"
      ],
      "properties": {
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "timed_out": {
          "type": "boolean"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        },
        "stdout_bytes_seen": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes_seen": {
          "type": "integer",
          "minimum": 0
        },
        "output_limit_exceeded": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
