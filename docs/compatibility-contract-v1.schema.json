{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArnabIITP/TwinCheck/blob/main/docs/compatibility-contract-v1.schema.json",
  "title": "TwinCheck Compatibility Contract v1",
  "description": "Declarative rules for deciding whether observable command-line behavior is compatible. Contracts never execute code.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stdout": {
      "$ref": "#/$defs/outputRule"
    },
    "stderr": {
      "$ref": "#/$defs/outputRule"
    },
    "compare_exit_code": {
      "type": "boolean"
    },
    "compare_timeout": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "outputRule": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "json"
          ]
        },
        "ignore_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^/(?:[^~]|~[01])*$"
          },
          "description": "Non-root RFC 6901 JSON Pointer paths to ignore, supported only in json mode."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "exact"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "ignore_paths": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
