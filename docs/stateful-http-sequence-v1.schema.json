{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArnabIITP/TwinCheck/blob/main/docs/stateful-http-sequence-v1.schema.json",
  "title": "TwinCheck Stateful HTTP Sequence v1",
  "description": "A bounded, user-authored sequence of HTTP requests for comparing two loopback API implementations. Templates use {{variable}} placeholders captured from earlier response observation envelopes.",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "health": {
      "type": "object", "required": ["schema_version", "method", "path", "assertions"],
      "properties": {
        "schema_version": { "const": 1 },
        "method": { "const": "GET", "description": "Health probes are read-only." },
        "path": { "type": "string", "minLength": 1, "pattern": "^/" },
        "assertions": {"type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "object", "required": ["pointer", "equals"],
            "properties": {
              "pointer": {"type": "string", "minLength": 2, "pattern": "^/(?:[^~]|~[01])+$"},
              "equals": {"type": ["string", "number", "boolean", "null"]}
            }, "additionalProperties": false}
        }
      }, "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "get", "post", "put", "patch", "delete", "options"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^/" },
        "body": {},
        "depends_on": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": "Named prerequisite steps must appear earlier in the workflow."
        },
        "capture": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "type": "string",
            "minLength": 2,
            "pattern": "^/(?:[^~]|~[01])+$"
          },
          "description": "Map names to non-root JSON Pointer paths in the response observation envelope, such as /body/id or /status."
        }
      },
      "additionalProperties": false
    }
  }
}
