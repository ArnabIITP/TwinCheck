{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArnabIITP/TwinCheck/blob/main/docs/counterexample-pack-v1.schema.json",
  "title": "TwinCheck Counterexample Regression Pack v1",
  "description": "Manifest for verified UTF-8 counterexamples and the compatibility contract under which they were discovered.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "pack_type",
    "contract_file",
    "contract_sha256",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool": {
      "const": "TwinCheck"
    },
    "pack_type": {
      "const": "counterexample-regression-pack"
    },
    "source_tool_version": {
      "type": "string"
    },
    "source_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_file": {
      "const": "contract.json"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "file",
        "input_sha256",
        "source_finding_numbers",
        "original_differences"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^cases/[a-f0-9]{64}\\.txt$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_finding_numbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "original_differences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
